# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp) ---
WA_TOKEN=                 # token de acceso permanente (usuario de sistema)
WA_PHONE_NUMBER_ID=       # ID del número que envía
WA_VERIFY_TOKEN=          # string que inventas tú, el mismo que pones en Meta al configurar el webhook
WA_APP_SECRET=            # App secret (Configuración > Básica), para validar la firma
WA_GRAPH_VERSION=v25.0
WA_TEMPLATE_NAME=reporte_reembolso   # plantilla aprobada con encabezado tipo DOCUMENTO
WA_TEMPLATE_LANG=es

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # solo en el servidor, nunca en el cliente

# --- Anthropic (lectura de boletas) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Vercel Cron ---
CRON_SECRET=              # Vercel lo manda como "Authorization: Bearer <CRON_SECRET>"
